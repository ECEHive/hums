{
	"name": "@ecehive/server",
	"version": "3.8.5",
	"type": "module",
	"scripts": {
		"start": "bun ./src/index.ts",
		"dev": "bun --watch ./src/index.ts",
		"build": "bun build --outdir ./dist --target bun ./src/index.ts",
		"check": "biome check --write",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@ecehive/env": "workspace:*",
		"@ecehive/features": "workspace:*",
		"@ecehive/logger": "workspace:*",
		"@ecehive/rest": "workspace:*",
		"@ecehive/trpc": "workspace:*",
		"@ecehive/workers": "workspace:*",
		"@fastify/cors": "^11.3.0",
		"@trpc/server": "11.8.0",
		"fastify": "^5.8.2"
	},
	"devDependencies": {
		"@ecehive/config": "workspace:*",
		"typescript": "^6.0.3"
	}
}
