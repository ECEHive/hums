{
	"name": "@ecehive/hums",
	"version": "3.8.0",
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*",
		"plugins/*"
	],
	"scripts": {
		"dev": "bun --filter './apps/*' dev",
		"check": "biome check --write",
		"test": "bun --filter './packages/*' --filter './apps/*' test",
		"typecheck": "bun --filter './packages/*' --filter './apps/*' --filter './plugins/*' typecheck",
		"set-version": "bun scripts/set-package-versions.ts",
		"reinstall": "bun scripts/reinstall.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4"
	}
}
